{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lan-studio.local/contracts/capabilities.schema.json",
  "title": "Lan Studio Capabilities",
  "description": "Compile-time capability manifest. The frontend renders ONLY the modules declared here; modules the backend does not reference produce no DOM at all. Generated by scripts/gen_capabilities.py from the actual .route() registrations in each component's main.rs.",
  "type": "object",
  "required": ["schema", "component", "runtime", "libs", "modules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "component": { "type": "string", "pattern": "^lan-[a-z0-9-]+$" },
    "runtime": { "type": "string", "enum": ["common-component", "standalone"] },
    "libs": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "tone", "area", "panels"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(core|lib)\\.[a-z0-9-]+$|^lan-[a-z0-9-]+\\.[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "icon": { "type": "string", "minLength": 1, "maxLength": 40 },
          "tone": { "type": "string", "enum": ["blue", "indigo", "green", "cyan", "purple", "amber", "teal", "red"] },
          "area": { "type": "string", "enum": ["workspace", "feature"] },
          "requires_lib": { "type": "string", "minLength": 1 },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "widget", "endpoint"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1, "maxLength": 60 },
                "widget": { "type": "string", "enum": ["kv-grid", "table", "form", "code-editor", "metric-grid", "log-list", "text-view", "action-list"] },
                "endpoint": {
                  "type": "object",
                  "required": ["method", "path"],
                  "additionalProperties": false,
                  "properties": {
                    "method": { "type": "string", "enum": ["GET", "POST"] },
                    "path": { "type": "string", "pattern": "^/api/" },
                    "write": { "type": "boolean" }
                  }
                },
                "columns": { "type": "array", "items": { "type": "object" } },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "method", "path"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "method": { "type": "string", "enum": ["GET", "POST"] },
                      "path": { "type": "string", "pattern": "^/api/" },
                      "write": { "type": "boolean" },
                      "fields": { "type": "array", "items": { "type": "object" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
