{
  "schema": 1,
  "component": "lan-ca",
  "runtime": "common-component",
  "libs": [
    "common-component"
  ],
  "modules": [
    {
      "id": "core.status",
      "title": "状态总览",
      "icon": "grid",
      "tone": "blue",
      "area": "workspace",
      "panels": [
        {
          "id": "status.kv",
          "title": "运行状态",
          "widget": "kv-grid",
          "endpoint": {
            "method": "GET",
            "path": "/api/status"
          }
        }
      ]
    },
    {
      "id": "core.config",
      "title": "配置管理",
      "icon": "sliders",
      "tone": "indigo",
      "area": "workspace",
      "panels": [
        {
          "id": "config.editor",
          "title": "配置编辑器",
          "widget": "code-editor",
          "endpoint": {
            "method": "GET",
            "path": "/api/config"
          },
          "actions": [
            {
              "id": "save",
              "label": "校验并保存",
              "method": "POST",
              "path": "/api/config",
              "write": true
            },
            {
              "id": "reload",
              "label": "重新载入",
              "method": "POST",
              "path": "/api/reload",
              "write": true
            },
            {
              "id": "export",
              "label": "导出快照",
              "method": "GET",
              "path": "/api/config/snapshot"
            },
            {
              "id": "import",
              "label": "导入快照",
              "method": "POST",
              "path": "/api/config/snapshot",
              "write": true
            }
          ]
        }
      ]
    },
    {
      "id": "core.observe",
      "title": "可观测",
      "icon": "activity",
      "tone": "cyan",
      "area": "workspace",
      "panels": [
        {
          "id": "observe.metrics",
          "title": "Prometheus 指标",
          "widget": "text-view",
          "endpoint": {
            "method": "GET",
            "path": "/api/metrics"
          }
        },
        {
          "id": "observe.logs",
          "title": "最近日志",
          "widget": "log-list",
          "endpoint": {
            "method": "GET",
            "path": "/api/logs"
          }
        }
      ]
    },
    {
      "id": "core.logs",
      "title": "日志",
      "icon": "terminal",
      "tone": "teal",
      "area": "workspace",
      "panels": [
        {
          "id": "logs.list",
          "title": "运行日志",
          "widget": "log-list",
          "endpoint": {
            "method": "GET",
            "path": "/api/logs"
          }
        }
      ]
    },
    {
      "id": "core.alerts",
      "title": "告警",
      "icon": "bell",
      "tone": "amber",
      "area": "workspace",
      "panels": [
        {
          "id": "alerts.kv",
          "title": "告警通道",
          "widget": "kv-grid",
          "endpoint": {
            "method": "GET",
            "path": "/api/alerts"
          }
        }
      ]
    },
    {
      "id": "core.history",
      "title": "版本历史",
      "icon": "history",
      "tone": "purple",
      "area": "workspace",
      "panels": [
        {
          "id": "history.list",
          "title": "快照与回滚",
          "widget": "table",
          "endpoint": {
            "method": "GET",
            "path": "/api/config/history"
          },
          "actions": [
            {
              "id": "rollback",
              "label": "回滚",
              "method": "POST",
              "path": "/api/config/rollback",
              "write": true
            }
          ]
        }
      ]
    },
    {
      "id": "lan-ca.root",
      "title": "根凭证",
      "icon": "cert",
      "tone": "purple",
      "area": "feature",
      "panels": [
        {
          "id": "ca.root",
          "title": "根指纹",
          "widget": "kv-grid",
          "endpoint": {
            "method": "GET",
            "path": "/api/ca/root"
          }
        },
        {
          "id": "ca.export",
          "title": "安全导出",
          "widget": "text-view",
          "endpoint": {
            "method": "GET",
            "path": "/api/ca/export"
          }
        }
      ]
    },
    {
      "id": "lan-ca.certs",
      "title": "凭证管理",
      "icon": "cert",
      "tone": "indigo",
      "area": "feature",
      "panels": [
        {
          "id": "ca.certs",
          "title": "已签发凭证",
          "widget": "table",
          "endpoint": {
            "method": "GET",
            "path": "/api/ca/certificates"
          },
          "columns": [
            {
              "key": "subject",
              "label": "主体"
            },
            {
              "key": "serial",
              "label": "序号"
            },
            {
              "key": "status",
              "label": "状态"
            }
          ],
          "actions": [
            {
              "id": "issue",
              "label": "签发",
              "method": "POST",
              "path": "/api/ca/issue",
              "fields": [
                {
                  "key": "subject",
                  "label": "主体",
                  "type": "text",
                  "required": true
                }
              ]
            },
            {
              "id": "renew",
              "label": "续期",
              "method": "POST",
              "path": "/api/ca/renew",
              "fields": [
                {
                  "key": "serial",
                  "label": "序号",
                  "type": "text",
                  "required": true
                }
              ]
            },
            {
              "id": "revoke",
              "label": "吊销",
              "method": "POST",
              "path": "/api/ca/revoke",
              "fields": [
                {
                  "key": "serial",
                  "label": "序号",
                  "type": "text",
                  "required": true
                }
              ]
            },
            {
              "id": "verify",
              "label": "验签",
              "method": "POST",
              "path": "/api/ca/verify",
              "fields": [
                {
                  "key": "token",
                  "label": "凭证",
                  "type": "textarea",
                  "required": true
                }
              ]
            }
          ]
        },
        {
          "id": "ca.crl",
          "title": "吊销列表",
          "widget": "table",
          "endpoint": {
            "method": "GET",
            "path": "/api/ca/crl"
          }
        }
      ]
    },
    {
      "id": "lan-ca.audit",
      "title": "签发审计",
      "icon": "history",
      "tone": "teal",
      "area": "feature",
      "panels": [
        {
          "id": "ca.audit",
          "title": "审计链",
          "widget": "log-list",
          "endpoint": {
            "method": "GET",
            "path": "/api/ca/audit"
          }
        }
      ]
    }
  ]
}
